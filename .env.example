
PYTHON_ENV=development
DEBUG=True
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# JWT signing key. Generate with: openssl rand -hex 32
SECRET_KEY=change-me-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AES-256-GCM key for bank account numbers at rest. Generate with:
# python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=change-me-base64-32-bytes
# Host ports are offset by 2 (5434, 6381, 5673) so this stack coexists with
# Posgage's (5433, 6380, 5672) on the same machine.
DB_URL=postgresql://balotly:balotly@localhost:5434/balotly
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

REDIS_URL=redis://localhost:6381/0
RABBITMQ_URL=amqp://guest:guest@localhost:5673/
WEBHOOK_QUEUE_NAME=balotly.webhooks
# Current one-container mode. Keep true for Dockerfile and `uvicorn --reload`.
RUN_EMBEDDED_WORKERS=true
EMBEDDED_WORKER_RESTART_BASE_SECONDS=1
EMBEDDED_WORKER_RESTART_MAX_SECONDS=30
